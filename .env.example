# ============================================================
# VeriLex — environment variable template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# ------------------------------------------------------------
# EURI (chat model provider — used for grading, rewriting,
#        generation, and validation nodes in the CRAG graph)
# ------------------------------------------------------------
EURI_API_KEY=replace-with-real-euri-api-key
EURI_BASE_URL=replace-with-real-euri-base-url
CHAT_MODEL=replace-with-chat-model-name

# ------------------------------------------------------------
# Jina (embedding provider — used at ingest time and query time)
# ------------------------------------------------------------
JINA_API_KEY=replace-with-real-jina-api-key
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBED_MODEL=jina-embeddings-v3

# ------------------------------------------------------------
# Qdrant (vector database — stores and retrieves document chunks)
# ------------------------------------------------------------
QDRANT_URL=replace-with-real-qdrant-cluster-url
QDRANT_API_KEY=replace-with-real-qdrant-api-key
QDRANT_COLLECTION=verilex

# ------------------------------------------------------------
# SQLite auth database
# Local development — path is relative to the project root (CWD)
DATABASE_URL=sqlite:///./app.db
# Render production — persistent disk mounted at /var/data
# DATABASE_URL=sqlite:////var/data/app.db

# ------------------------------------------------------------
# Session signing key
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# ------------------------------------------------------------
# CORS — which frontend origin the backend will accept
# Local development:
FRONTEND_URL=http://localhost:5173
# Render production — set this to your Vercel deployment URL:
# FRONTEND_URL=https://your-verilex-app.vercel.app

# ------------------------------------------------------------
# Cookie security
# false = SameSite=Lax, no Secure flag  (required for local HTTP)
# true  = SameSite=None + Secure flag   (required for cross-site HTTPS in production)
COOKIE_SECURE=false
